<Window x:Class="MockLab.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Отклик — локальные API" Width="1180" Height="780" MinWidth="800" MinHeight="550" WindowStartupLocation="CenterScreen" Background="#F3F5F9">
<DockPanel Margin="12">
<StackPanel DockPanel.Dock="Top"><WrapPanel><TextBlock Text="Отклик" FontSize="26" FontWeight="Bold" Foreground="#172B49" Margin="8"/><Button Content="Новый" Click="New"/><Button Content="Открыть" Click="Open"/><Button Content="Сохранить" Click="Save"/><Button Content="Экспорт JSON" Click="Export"/><Button Content="Импорт OpenAPI" Click="Import"/><Button x:Name="StartButton" Content="▶ Запустить" Click="StartStop" Background="#BDEFE4"/><Button Content="Копировать URL" Click="CopyUrl"/><Button Content="Сброс сценария" Click="Reset"/></WrapPanel><WrapPanel><TextBlock Text="Проект" VerticalAlignment="Center"/><TextBox x:Name="ProjectName" Width="260" TextChanged="Changed"/><TextBlock Text="Порт" VerticalAlignment="Center"/><TextBox x:Name="Port" Width="80" TextChanged="Changed"/><CheckBox x:Name="Cors" Content="CORS для браузера" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed" Margin="10"/><TextBlock x:Name="State" VerticalAlignment="Center" TextWrapping="Wrap" Margin="10"/></WrapPanel></StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DockPanel Background="#172438"><StackPanel DockPanel.Dock="Top"><TextBlock Text="МАРШРУТЫ" Foreground="White" Margin="12" FontWeight="Bold"/><WrapPanel><Button Content="+" Click="AddRoute" ToolTip="Добавить маршрут"/><Button Content="Дубль" Click="DuplicateRoute"/><Button Content="Удалить" Click="DeleteRoute"/></WrapPanel></StackPanel><ListBox x:Name="Routes" SelectionChanged="SelectRoute" Background="#172438" Foreground="White" BorderThickness="0"/></DockPanel>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="230"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Editor">
<WrapPanel><CheckBox x:Name="RouteEnabled" Content="Включён" Margin="8" Checked="Changed" Unchecked="Changed"/><ComboBox x:Name="Method" Width="90" SelectionChanged="Changed"><ComboBoxItem Content="GET"/><ComboBoxItem Content="POST"/><ComboBoxItem Content="PUT"/><ComboBoxItem Content="PATCH"/><ComboBoxItem Content="DELETE"/></ComboBox><TextBox x:Name="PathBox" Width="380" TextChanged="Changed"/><Button Content="Применить маршрут" Click="Apply"/><Button Content="Тест GET" Click="TestRequest"/></WrapPanel>
<TabControl><TabItem Header="Ответы"><StackPanel><WrapPanel><ComboBox x:Name="Responses" Width="250" SelectionChanged="SelectResponse"/><Button Content="+ Ответ" Click="AddResponse"/><Button Content="Удалить ответ" Click="DeleteResponse"/><Button Content="↑" Click="MoveUp" ToolTip="Повысить приоритет"/><Button Content="↓" Click="MoveDown" ToolTip="Понизить приоритет"/></WrapPanel><WrapPanel><TextBlock Text="Имя" VerticalAlignment="Center"/><TextBox x:Name="ResponseName" Width="190" TextChanged="Changed"/><CheckBox x:Name="ResponseEnabled" Content="Включён" Margin="8" Checked="Changed" Unchecked="Changed"/><CheckBox x:Name="Fallback" Content="Fallback" Margin="8" Checked="Changed" Unchecked="Changed"/><TextBlock Text="Статус" VerticalAlignment="Center"/><TextBox x:Name="StatusCode" Width="65" TextChanged="Changed"/><TextBlock Text="Задержка, мс" VerticalAlignment="Center"/><TextBox x:Name="Delay" Width="80" TextChanged="Changed"/></WrapPanel><TextBlock Text="Content-Type"/><TextBox x:Name="ContentType" TextChanged="Changed"/><TextBlock Text="Заголовки (JSON-объект)"/><TextBox x:Name="Headers" FontFamily="Consolas" Height="65" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextChanged="Changed"/><WrapPanel><TextBlock Text="Тело ответа (до 1 МиБ)" VerticalAlignment="Center"/><Button Content="Проверить / форматировать JSON" Click="FormatJson"/></WrapPanel><TextBox x:Name="Body" FontFamily="Consolas" FontSize="14" Height="220" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="Changed"/></StackPanel></TabItem>
<TabItem Header="Правила"><StackPanel><TextBlock Margin="10" TextWrapping="Wrap" Text="Все условия выбранного ответа соединяются AND. Ответы проверяются сверху вниз. Первый совпавший ответ выигрывает; иначе fallback. Body: точечный путь user.role, массивы и ключи с точкой не поддерживаются."/><DataGrid x:Name="Conditions" Height="230" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True" CellEditEnding="Changed"><DataGrid.Columns><DataGridTextColumn Header="Источник: query/header/body/path" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="Ключ" Binding="{Binding Key}" Width="*"/><DataGridTextColumn Header="equals/contains/exists" Binding="{Binding Operator}" Width="*"/><DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid><TextBlock Text="Удалить условие: выделите строку и нажмите Delete. Изменения сохраняет кнопка «Применить маршрут»." Margin="10" TextWrapping="Wrap"/></StackPanel></TabItem>
<TabItem Header="Сценарий"><StackPanel><TextBlock Text="Режим маршрута" Margin="8"/><ComboBox x:Name="Mode" SelectedIndex="0" SelectionChanged="Changed"><ComboBoxItem Content="rules"/><ComboBoxItem Content="sequence"/></ComboBox><TextBlock Text="Окончание последовательности" Margin="8"/><ComboBox x:Name="EndBehavior" SelectedIndex="0" SelectionChanged="Changed"><ComboBoxItem Content="holdLast"/><ComboBoxItem Content="loop"/></ComboBox><TextBlock Text="Порядок: номера ответов через запятую, начиная с 1. Например: 1,2,3. Ответы могут повторяться." Margin="8" TextWrapping="Wrap"/><TextBox x:Name="Sequence" TextChanged="Changed"/><TextBlock x:Name="ResponseLegend" Margin="8" TextWrapping="Wrap"/></StackPanel></TabItem></TabControl>
</StackPanel></ScrollViewer>
<Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DockPanel><WrapPanel DockPanel.Dock="Top"><TextBlock Text="ЖУРНАЛ · последние 500" VerticalAlignment="Center" FontWeight="Bold"/><Button Content="Очистить" Click="ClearLog"/><Button Content="Экспорт" Click="ExportLog"/></WrapPanel><ListBox x:Name="Logs" SelectionChanged="SelectLog" DisplayMemberPath="Summary"/></DockPanel><TextBox Grid.Column="1" x:Name="LogDetails" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></Grid></Grid></DockPanel></Window>
